# Sizing for M · manual, layered on a JVM env file (the later file wins; shell variables win over both):
#   docker compose --env-file temurin-21.env --env-file manual.env up --build
# Uncomment and edit what you want to change; anything left commented keeps compose.yaml's default.

# The container limit (mem_limit and memswap_limit, so no swap): 512m, 768m, 1g, 2g, …
#LEAKLAB_MANUAL_MEM=1g
# CPUs. HotSpot picks Serial GC below 2 CPUs or 1792 MiB, G1 above.
#LEAKLAB_MANUAL_CPUS=2
# The JVM's sizing flags: -Xmx…, -XX:MaxRAMPercentage=…, -XX:MaxDirectMemorySize=…, -XX:+UseG1GC, -XX:+ExitOnOutOfMemoryError, …
#LEAKLAB_MANUAL_JAVA_OPTS=-XX:MaxRAMPercentage=75
# The leak target at start: HEAP | DIRECT | NATIVE (switchable in the UI).
#LEAKLAB_MANUAL_LOAD_MODE=HEAP
# The pre-kill evidence capture: false to watch an OOMKill leave nothing behind; threshold = fraction of the limit.
#LEAKLAB_MANUAL_GUARDIAN=true
#LEAKLAB_MANUAL_GUARDIAN_THRESHOLD=0.90
# After an OutOfMemoryError the load engine pauses (false) or keeps driving load (true), as real traffic would.
# Switchable in the UI at runtime.
#LEAKLAB_MANUAL_KEEP_RUNNING_ON_OOM=false
