# Eclipse Temurin 25 (Eclipse Adoptium) — the HotSpot VM.   docker compose --env-file temurin-25.env up --build
# Stack leaklab-temurin-25 · containers leaklab-<scenario>-temurin-25 · image leaklab:1.0.0-temurin-25 · A–D http://localhost:7080–7083, M :7084, G :7085
LEAKLAB_JVM_NAME=temurin
LEAKLAB_JAVA_VERSION=25
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=eclipse-temurin:25-jdk
LEAKLAB_PORT_PREFIX=70
LEAKLAB_DUMPS=./dumps/temurin-25
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
