# Oracle's OpenJDK 21 build — the HotSpot VM.   docker compose --env-file oracle-21.env up --build
# Stack leaklab-oracle-21 · containers leaklab-<scenario>-oracle-21 · image leaklab:1.0.0-oracle-21 · A–D http://localhost:9180–9183, M :9184, G :9185
# Oracle updates its OpenJDK builds for six months only: this image is 21.0.2 (January 2024), without security fixes.
# Fine for the lab. Oracle JDK 21 (current updates, Oracle licence terms) instead: docker login container-registry.oracle.com,
# then LEAKLAB_HOTSPOT_IMAGE=container-registry.oracle.com/java/jdk:21
LEAKLAB_JVM_NAME=oracle
LEAKLAB_JAVA_VERSION=21
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=container-registry.oracle.com/java/openjdk:21
LEAKLAB_PORT_PREFIX=91
LEAKLAB_DUMPS=./dumps/oracle-21
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
