# Red Hat build of OpenJDK 21 — the HotSpot VM, on UBI 9. The default: also what compose runs with no env file.   docker compose --env-file redhat-21.env up --build
# Stack leaklab-redhat-21 · containers leaklab-<scenario>-redhat-21 · image leaklab:1.0.0-redhat-21 · A–D http://localhost:6180–6183, M :6184, G :6185
# Free to pull from registry.access.redhat.com (UBI terms); supported as part of a Red Hat subscription.
LEAKLAB_JVM_NAME=redhat
LEAKLAB_JAVA_VERSION=21
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=registry.access.redhat.com/ubi9/openjdk-21
LEAKLAB_PORT_PREFIX=61
LEAKLAB_DUMPS=./dumps/redhat-21
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
