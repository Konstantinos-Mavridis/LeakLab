# Oracle's OpenJDK 25 build — the HotSpot VM.   docker compose --env-file oracle-25.env up --build
# Stack leaklab-oracle-25 · containers leaklab-<scenario>-oracle-25 · image leaklab:1.0.0-oracle-25 · A–D http://localhost:9080–9083, M :9084, G :9085
# Oracle JDK (NFTC licence, current updates) instead: docker login container-registry.oracle.com, then
#   LEAKLAB_HOTSPOT_IMAGE=container-registry.oracle.com/java/jdk:25
LEAKLAB_JVM_NAME=oracle
LEAKLAB_JAVA_VERSION=25
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=container-registry.oracle.com/java/openjdk:25
LEAKLAB_PORT_PREFIX=90
LEAKLAB_DUMPS=./dumps/oracle-25
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
