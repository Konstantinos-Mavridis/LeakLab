# IBM Semeru Runtime 17 — the Eclipse OpenJ9 VM.   docker compose --env-file semeru-17.env up --build
# Stack leaklab-semeru-17 · containers leaklab-<scenario>-semeru-17 · image leaklab:1.0.0-semeru-17 · A–D http://localhost:8780–8783, M :8784, G :8785
LEAKLAB_JVM_NAME=semeru
LEAKLAB_JAVA_VERSION=17
LEAKLAB_JVM=openj9
LEAKLAB_OPENJ9_IMAGE=ibm-semeru-runtimes:open-17-jre-noble
LEAKLAB_PORT_PREFIX=87
LEAKLAB_DUMPS=./dumps/semeru-17
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
