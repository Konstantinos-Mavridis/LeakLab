# IBM Semeru Runtime 21 — the Eclipse OpenJ9 VM.   docker compose --env-file semeru-21.env up --build
# Stack leaklab-semeru-21 · containers leaklab-<scenario>-semeru-21 · image leaklab:1.0.0-semeru-21 · A–D http://localhost:8180–8183, M :8184, G :8185
LEAKLAB_JVM_NAME=semeru
LEAKLAB_JAVA_VERSION=21
LEAKLAB_JVM=openj9
LEAKLAB_OPENJ9_IMAGE=ibm-semeru-runtimes:open-21-jre-noble
LEAKLAB_PORT_PREFIX=81
LEAKLAB_DUMPS=./dumps/semeru-21
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
