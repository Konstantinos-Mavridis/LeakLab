# IBM Semeru Runtime 25 — the Eclipse OpenJ9 VM.   docker compose --env-file semeru-25.env up --build
# Stack leaklab-semeru-25 · containers leaklab-<scenario>-semeru-25 · image leaklab:1.0.0-semeru-25 · A–D http://localhost:8080–8083, M :8084, G :8085
LEAKLAB_JVM_NAME=semeru
LEAKLAB_JAVA_VERSION=25
LEAKLAB_JVM=openj9
LEAKLAB_OPENJ9_IMAGE=ibm-semeru-runtimes:open-25-jre-noble
LEAKLAB_PORT_PREFIX=80
LEAKLAB_DUMPS=./dumps/semeru-25
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
