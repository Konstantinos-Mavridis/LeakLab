# Red Hat build of OpenJDK 25 — the HotSpot VM, on UBI 9.   docker compose --env-file redhat-25.env up --build
# Stack leaklab-redhat-25 · containers leaklab-<scenario>-redhat-25 · image leaklab:1.0.0-redhat-25 · A–D http://localhost:6080–6083, M :6084, G :6085
LEAKLAB_JVM_NAME=redhat
LEAKLAB_JAVA_VERSION=25
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=registry.access.redhat.com/ubi9/openjdk-25
LEAKLAB_PORT_PREFIX=60
LEAKLAB_DUMPS=./dumps/redhat-25
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
