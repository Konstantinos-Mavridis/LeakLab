# Oracle's OpenJDK 17 build — the HotSpot VM.   docker compose --env-file oracle-17.env up --build
# Stack leaklab-oracle-17 · containers leaklab-<scenario>-oracle-17 · image leaklab:1.0.0-oracle-17 · A–D http://localhost:9780–9783, M :9784, G :9785
# Oracle updates its OpenJDK builds for six months only: this image is 17.0.2 (January 2022), without security fixes.
# Fine for the lab. Oracle JDK 17 (current updates, Oracle licence terms) instead: docker login container-registry.oracle.com,
# then LEAKLAB_HOTSPOT_IMAGE=container-registry.oracle.com/java/jdk:17
LEAKLAB_JVM_NAME=oracle
LEAKLAB_JAVA_VERSION=17
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=container-registry.oracle.com/java/openjdk:17
LEAKLAB_PORT_PREFIX=97
LEAKLAB_DUMPS=./dumps/oracle-17
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
