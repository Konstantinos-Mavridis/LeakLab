# Eclipse Temurin 17 (Eclipse Adoptium) — the HotSpot VM.   docker compose --env-file temurin-17.env up --build
# Stack leaklab-temurin-17 · containers leaklab-<scenario>-temurin-17 · image leaklab:1.0.0-temurin-17 · A–D http://localhost:7780–7783, M :7784, G :7785
LEAKLAB_JVM_NAME=temurin
LEAKLAB_JAVA_VERSION=17
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=eclipse-temurin:17-jdk
LEAKLAB_PORT_PREFIX=77
LEAKLAB_DUMPS=./dumps/temurin-17
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
