# Eclipse Temurin 21 (Eclipse Adoptium) — the HotSpot VM.   docker compose --env-file temurin-21.env up --build
# Stack leaklab-temurin-21 · containers leaklab-<scenario>-temurin-21 · image leaklab:1.0.0-temurin-21 · A–D http://localhost:7180–7183, M :7184, G :7185
LEAKLAB_JVM_NAME=temurin
LEAKLAB_JAVA_VERSION=21
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=eclipse-temurin:21-jdk
LEAKLAB_PORT_PREFIX=71
LEAKLAB_DUMPS=./dumps/temurin-21
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
