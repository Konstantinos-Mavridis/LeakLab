# Read by compose only when no --env-file is given: a plain `docker compose up` then runs M · manual on the default
# JVM, the Red Hat build of OpenJDK 21 (compose.yaml's defaults, the same as redhat-21.env). The <jvm>-<version>.env
# files set the same, so `up` means manual everywhere; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
