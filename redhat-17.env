# Red Hat build of OpenJDK 17 — the HotSpot VM, on UBI 8 (ubi8/openjdk-17, image 1.21).   docker compose --env-file redhat-17.env up --build
# Stack leaklab-redhat-17 · containers leaklab-<scenario>-redhat-17 · image leaklab:1.0.0-redhat-17 · A–D http://localhost:6780–6783, M :6784, G :6785
# Free to pull from registry.access.redhat.com (UBI terms); supported as part of a Red Hat subscription.
# The tag is pinned: image 1.21 ships OpenJDK 17.0.16 (July 2025) on RHEL 8.10 and receives no further updates.
# Drop ":1.21" (or use ubi9/openjdk-17) for the current 17.0.x.
LEAKLAB_JVM_NAME=redhat
LEAKLAB_JAVA_VERSION=17
LEAKLAB_JVM=hotspot
LEAKLAB_HOTSPOT_IMAGE=registry.access.redhat.com/ubi8/openjdk-17:1.21
LEAKLAB_PORT_PREFIX=67
LEAKLAB_DUMPS=./dumps/redhat-17
# A plain `up` starts M · manual; `--profile all up` starts A–D and G instead.
COMPOSE_PROFILES=manual
